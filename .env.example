# Скопируй в .env и подставь свои значения.
# Префикс EXPO_PUBLIC_ обязателен — иначе переменная не попадёт в приложение.
#
# Ключей Anthropic и OpenAI здесь нет: они лежат в Secret Manager и нужны
# только прокси-функции `api` (functions/). Положить или сменить ключ:
#   npx firebase-tools functions:secrets:set ANTHROPIC_API_KEY
#   npx firebase-tools functions:secrets:set OPENAI_API_KEY
# и задеплоить функцию: npx firebase-tools deploy --only functions

# Firebase — вход, синхронизация и адрес прокси (из PROJECT_ID).
# Клиентский конфиг Firebase не секрет: доступ решают правила и токены.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Другой адрес прокси, например эмулятор; обычно не нужен.
# EXPO_PUBLIC_API_URL=http://127.0.0.1:5001/madame-poly/europe-west1/api

# RevenueCat — публичные ключи SDK, по одному на магазин.
# Берутся в консоли RevenueCat: Project settings → API keys → App-specific.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
