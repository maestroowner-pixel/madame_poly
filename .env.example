# Скопируй в .env и подставь свои ключи.
# Префикс EXPO_PUBLIC_ обязателен — иначе переменная не попадёт в приложение.
# Ключи инлайнятся в бандл: это приемлемо для личной сборки, но не для стора.

# Whisper (распознавание) и tts-1 (озвучка) — один ключ на оба
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Диалог и разбор ошибок
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# RevenueCat — публичные ключи SDK, по одному на магазин.
# Берутся в консоли RevenueCat: Project settings → API keys → App-specific.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
