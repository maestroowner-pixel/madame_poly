{
  "expo": {
    "name": "Madame Poly",
    "slug": "Polyglotta",
    "version": "1.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "VL4B4R8D84",
      "bundleIdentifier": "com.kukalab.polyglotta",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "10314"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1046",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kukalab.polyglotta",
      "permissions": [
        "CAMERA"
      ],
      "versionCode": 10314
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Madame Poly listens to your speech to recognise it and reply."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "imageWidth": 1290,
          "backgroundColor": "#0B1046",
          "android": {
            "image": "./assets/icon.png",
            "imageWidth": 220,
            "backgroundColor": "#0B1046"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Madame Poly uses a photo from your library as your avatar.",
          "cameraPermission": "Madame Poly opens the camera to take a photo for your avatar."
        }
      ],
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "uk",
              "es",
              "ru",
              "de",
              "fr",
              "pt",
              "zh-Hans",
              "ja",
              "ko"
            ],
            "android": [
              "en",
              "uk",
              "es",
              "ru",
              "de",
              "fr",
              "pt",
              "zh",
              "ja",
              "ko"
            ]
          }
        }
      ],
      "./plugins/withSceneLifecycle",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#17769F"
        }
      ]
    ],
    "backgroundColor": "#EFF6FD",
    "locales": {
      "en": "./locales/en.json",
      "uk": "./locales/uk.json",
      "es": "./locales/es.json",
      "ru": "./locales/ru.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "pt": "./locales/pt.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json"
    }
  }
}
