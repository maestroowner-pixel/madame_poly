{
  "expo": {
    "name": "Madame Poly",
    "slug": "Polyglotta",
    "version": "1.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kukalab.polyglotta"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1046",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kukalab.polyglotta",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Madame Polyglotta listens to your speech to recognise it and reply."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0B1046"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Madame Polyglotta uses a photo from your library as your avatar.",
          "cameraPermission": "Madame Polyglotta opens the camera to take a photo for your avatar."
        }
      ],
      "expo-sharing",
      "expo-localization"
    ],
    "backgroundColor": "#EFF6FD"
  }
}
